# ~/projects/pyvar/.env.example
# Copy to .env and fill in values.
# Never commit .env to git.

APP_ENV=development
JWT_SECRET=dev-jwt-secret-change-me

# Set by docker-compose.yml — override here if needed
POSTGRES_DSN=postgresql+asyncpg://pyvar:pyvar@postgres:5432/pyvar
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional — only needed if writing results to S3 in dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=

# Optional — leave blank to disable Sentry in dev
SENTRY_DSN=
