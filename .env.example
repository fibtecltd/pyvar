# pyvar.com — environment variables
# Copy to .env and fill in values before running

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Security ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://postgres:pyvar@localhost:5432/pyvar

# ── S3 / MinIO ─────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000   # remove for real AWS S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pyvar-results
S3_REGION=us-east-1

# ── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=                             # leave blank in development
LOG_LEVEL=INFO

# ── Monte Carlo defaults ───────────────────────────────────────────────────────
DEFAULT_N_SIMULATIONS=100000
DEFAULT_CONFIDENCE_LEVEL=0.99
DEFAULT_HORIZON_DAYS=1
MAX_N_SIMULATIONS=1000000
