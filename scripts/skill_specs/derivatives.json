  "examples": [
    {
      "title": "Black-Scholes call price and Greeks",
      "intro": "A six-month at-the-forward call. `tau` is in years, `rate` and `sigma` are decimals. Vega is per 1.00 of volatility (divide by 100 for per volatility point).",
      "calls": [
        {
          "function": "black_scholes_european_option",
          "request": {
            "spot": 100,
            "strike": 105,
            "rate": 0.03,
            "sigma": 0.2,
            "tau": 0.5,
            "option_type": "call"
          },
          "returns": [
            "price",
            "d1",
            "d2"
          ]
        },
        {
          "function": "black_scholes_greeks",
          "request": {
            "spot": 100,
            "strike": 105,
            "rate": 0.03,
            "sigma": 0.2,
            "tau": 0.5,
            "option_type": "call"
          },
          "returns": [
            "delta",
            "gamma",
            "vega",
            "theta",
            "rho"
          ]
        }
      ]
    },
    {
      "title": "Fixed-coupon bond price and modified duration",
      "intro": "A 10-year 5% semi-annual bond priced at a 4% yield, then its modified duration from the same cash flows (times in years).",
      "calls": [
        {
          "function": "bond_pricer_fixed_coupon",
          "request": {
            "face_value": 100,
            "coupon_rate": 0.05,
            "yield_rate": 0.04,
            "maturity": 10,
            "frequency": 2
          },
          "returns": [
            "price",
            "clean_price",
            "cashflows"
          ]
        },
        {
          "function": "modified_duration",
          "request": {
            "cashflows": [
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              2.5,
              102.5
            ],
            "times": [
              0.5,
              1.0,
              1.5,
              2.0,
              2.5,
              3.0,
              3.5,
              4.0,
              4.5,
              5.0,
              5.5,
              6.0,
              6.5,
              7.0,
              7.5,
              8.0,
              8.5,
              9.0,
              9.5,
              10.0
            ],
            "yield_rate": 0.04,
            "frequency": 2
          },
          "returns": [
            "modified_duration",
            "macaulay_duration",
            "price"
          ]
        }
      ]
    }
