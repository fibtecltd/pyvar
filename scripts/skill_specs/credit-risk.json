{
  "skill": "credit-risk",
  "domain": "credit-risk",
  "client_ns": "credit_risk",
  "title": "Credit Risk",
  "version": "1.1.0",
  "description": "Run pyvar's 55 credit-risk functions on the live pyvar.com API: expected loss, PD/LGD/EAD, Vasicek and Monte Carlo credit VaR, IRB and standardised capital, SA-CCR and XVA (CVA/DVA/FVA), CDS pricing, IFRS 9 ECL, Altman Z and other scoring models. Use when the user wants credit-risk numbers computed rather than only explained. Needs a free pyvar API key; the skill explains how to get one.",
  "tagline": "Credit-risk calculations: expected and unexpected loss, regulatory capital, portfolio credit models, counterparty risk and XVA, CDS, IFRS 9 ECL and scoring. Pick the function in **Functions** below; the **Worked examples** show the request shape.",
  "tags": [
    "credit-risk",
    "PD",
    "LGD",
    "EAD",
    "IRB",
    "XVA",
    "CVA",
    "IFRS9",
    "ECL",
    "CDS",
    "CCR",
    "SA-CCR",
    "KMV",
    "Merton",
    "scoring"
  ],
  "examples": [
    {
      "title": "Expected loss and Vasicek credit VaR on a 50m exposure",
      "intro": "Expected loss is PD x LGD x EAD. The Vasicek single-factor model then gives the 99.9% loss quantile (the Basel IRB confidence level) for a granular portfolio.",
      "calls": [
        {
          "function": "expected_loss_el_computation",
          "request": {
            "pd": 0.02,
            "lgd": 0.45,
            "ead": 50000000
          },
          "returns": [
            "el",
            "el_rate",
            "pd",
            "lgd",
            "ead"
          ]
        },
        {
          "function": "credit_var_analytical_vasicek",
          "request": {
            "pd": 0.02,
            "lgd": 0.45,
            "ead_total": 50000000,
            "asset_correlation": 0.15,
            "confidence_level": 0.999
          },
          "returns": [
            "var",
            "el",
            "ul",
            "loss_rate_q",
            "confidence_level"
          ]
        }
      ]
    },
    {
      "title": "Altman Z-score for one borrower",
      "intro": "Balance-sheet and income inputs in any one currency unit. The result carries the score and its zone (safe above 2.99, distress below 1.81).",
      "calls": [
        {
          "function": "altman_z_score_credit_scoring",
          "request": {
            "working_capital": 120,
            "retained_earnings": 300,
            "ebit": 90,
            "market_value_equity": 800,
            "sales": 1200,
            "total_assets": 1000,
            "total_liabilities": 400
          },
          "returns": [
            "z_score",
            "zone",
            "x1",
            "x2",
            "x3",
            "x4",
            "x5"
          ]
        }
      ]
    }
  ],
