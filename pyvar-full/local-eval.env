# pyvar-full/local-eval.env
#
# Checked-in, intentionally-fake credentials for local evaluation only.
# Isolated to this compose project's own network/volumes -- nothing
# here is reachable from outside `docker compose up` in this directory.
#
# DO NOT reuse these values anywhere reachable from the internet or a
# real network. Rotate JWT_SECRET yourself if you're doing anything
# beyond a quick local try-out.

APP_ENV=development
JWT_SECRET=pyvar-full-local-eval-not-for-production

POSTGRES_DSN=postgresql+asyncpg://pyvar:pyvar@postgres:5432/pyvar
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

NUMBA_CACHE_DIR=/home/pyvar/.cache/numba
PYTHONUNBUFFERED=1

# Left blank deliberately -- billing routes 503 cleanly without these
# (api/routes/billing.py's _require_billing_configured()). Supply real
# Stripe test-mode keys here only if you specifically want to exercise
# the billing flow locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Left blank deliberately -- result storage (storage/s3.py) is not
# configured for local evaluation. VaR job results compute correctly;
# only their S3/Parquet persistence step is unavailable. See README.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Left blank deliberately -- no Sentry project for local evaluation.
SENTRY_DSN=
